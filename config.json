{
  "project_name": "Personal Knowledge Summary System",
  "version": "1.0.0",
  "description": "A hybrid reranking and interpretable generation-based personal knowledge auto-summary system",
  
  "data": {
    "raw_data_dir": "./data/raw/",
    "processed_data_dir": "./data/processed/",
    "labels_dir": "./data/labels/",
    "processed_file": "./data/processed/processed.jsonl"
  },
  
  "output": {
    "root_dir": "./output/",
    "summaries_dir": "./output/summaries/",
    "reports_dir": "./output/reports/",
    "models_dir": "./output/models/",
    "experiments_dir": "./output/experiments/",
    "paper_dir": "./output/paper/"
  },
  
  "embedding": {
    "model_name": "BAAI/bge-base-zh",
    "device": "cpu"
  },
  
  "chroma": {
    "collection_name": "personal_notes",
    "persist_dir": "./.chroma/",
    "similarity_metric": "cosine"
  },
  
  "retrieval": {
    "top_candidates_after_retrieval": 50,
    "similarity_threshold": 0.0
  },
  
  "reranking": {
    "final_top_k_for_summary": 5,
    "mode": "hybrid",
    "learning_mode": "manual",
    "rerank_learning_samples": 30,
    "manual_weights": {
      "semantic_sim": 0.55,
      "keyword_overlap": 0.25,
      "title_overlap": 0.08,
      "position_score": 0.07,
      "length_score": 0.05
    }
  },
  
  "summarization": {
    "max_summary_length": 250,
    "min_summary_length": 50,
    "num_keywords": 5,
    "use_zhipu_ai": true,
    "zhipu_model": "glm-4-flash",
    "template_mode": "fallback"
  },
  
  "evaluation": {
    "rouge_types": ["rouge1", "rouge2", "rougeL"],
    "ndcg_k": 5,
    "map_k": 5
  },
  
  "logging": {
    "level": "INFO",
    "log_file": "./output/system.log"
  },
  
  "preprocessing": {
    "language": "auto",
    "remove_html": true,
    "remove_special_chars": true,
    "min_text_length": 20,
    "sentence_splitter": "nltk"
  }
}
